# 로컬 백엔드 연결 모드 (npm run dev:api / build:api / preview:api)
# - 이 PC 에서 띄운 백엔드(127.0.0.1:8000)에만 연결한다. 배포된 서버 주소를 넣지 않는다.
# - 비밀값 없음. VITE_ 로 시작하는 값은 브라우저 번들에 들어가므로 키·토큰을 절대 넣지 않는다.
VITE_DATA_SOURCE=http
# 비워 두면 같은 주소로 요청하고, Vite 가 /api 를 아래 주소로 넘긴다 (CORS 불필요)
VITE_API_BASE_URL=
# Vite 프록시 대상 (브라우저 번들에 들어가지 않음)
HOMEVIS_API_TARGET=http://127.0.0.1:8000
