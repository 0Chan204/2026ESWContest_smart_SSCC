!/room/air-purifier/tests/check_backend.py

# S3 USB gateway: local settings and credential backups.
/gateway/esp32s3-gateway/host/*.local.json
/gateway/esp32s3-gateway/host/backups/
/gateway/esp32s3-gateway/build-*/
!/gateway/esp32s3-gateway/tests/
!/gateway/esp32s3-gateway/tests/test_gateway.py

# Private environment and device-specific settings
.env
.env.*
!.env.example
*.local.json
build-*/
