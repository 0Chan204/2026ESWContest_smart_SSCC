# Repository-specific exclusions
.agents/
.codex/
.devcontainer/
.vscode/
tests/
Kconfig.projbuild
.clangd
.aws
build-network-check/

# Build directories and compiled artifacts
build/
dist/
*.d
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.ilk
*.exp
*.gch
*.pch
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# ESP-IDF generated configuration and downloaded dependencies
sdkconfig
sdkconfig.old
flasher_args.json
**/components/.idf/
managed_components/
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json

# Python caches and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
venv/
.venv/
env/

# Editor caches and user settings
.ccls-cache/
*.user
*.workspace
*.suo
*.sln.docstates

# Temporary files and logs
*~
*.swp
*.swo
*.bak
*.tmp
*.log

# Operating system metadata
.DS_Store
.AppleDouble
.LSOverride
.directory
Thumbs.db
ehthumbs.db
Desktop.ini

# Toilet light/fan: alternate build outputs and portable model tests.
/toilet/toilet-light-fan/build-*/
!/toilet/toilet-light-fan/tests/
!/toilet/toilet-light-fan/tests/run.sh
!/toilet/toilet-light-fan/tests/test_model.c

# Kitchen light/hood: alternate build outputs and portable model tests.
/kitchen/kitchen-light-hood/build-*/
!/kitchen/kitchen-light-hood/tests/
!/kitchen/kitchen-light-hood/tests/run.sh
!/kitchen/kitchen-light-hood/tests/test_model.c

# Room light: alternate build outputs and portable model tests.
/room/room-light/build-*/
!/room/room-light/tests/
!/room/room-light/tests/run.sh
!/room/room-light/tests/test_model.c

