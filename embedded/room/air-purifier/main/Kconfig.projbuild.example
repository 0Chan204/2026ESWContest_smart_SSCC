menu "HomeVIS air purifier"

    config AP_WIFI_SSID
        string "Wi-Fi SSID"
        default "HomeVIS-Devices"

    config AP_WIFI_PASSWORD
        string "Wi-Fi password (empty for open network)"
        default ""

    config AP_MQTT_URI
        string "MQTT broker URI"
        default "mqtt://192.168.4.1:1883"
        help
            Use mqtt://host:port or mqtts://host:port.
            TLS uses the ESP-IDF public CA certificate bundle.

    config AP_MQTT_USERNAME
        string "MQTT username (empty for anonymous)"
        default ""

    config AP_MQTT_PASSWORD
        string "MQTT password"
        default ""

    config AP_MQTT_CLIENT_ID
        string "MQTT client ID (unique per physical board)"
        default "homevis-room-air-purifier"

    config AP_NTP_SERVER
        string "NTP server"
        default "192.168.4.1"

    config AP_RELAY_GPIO
        int "Fan relay GPIO"
        range 0 23
        default 18
        help
            Allowed GPIOs: 0/1/2/3/6/7/18/19/20/21/22/23.
            Must differ from the ADC GPIO.

    config AP_RELAY_ACTIVE_LOW
        bool "Relay is active low"
        default y

    config AP_MQ135_GPIO
        int "MQ135 analog output GPIO (through voltage divider)"
        range 0 6
        default 0
        help
            Allowed ADC GPIOs: 0/1/2/3/6. GPIO4/5 are boot strapping pins.
            Do not connect a 5V analog output directly to the ESP32.

    config AP_MQ135_SUPPLY_MV
        int "MQ135 sensing circuit supply (mV)"
        range 1000 5500
        default 5000
        help
            Sensing circuit Vc, not ADC reference voltage. Current module uses 5V.

    config AP_MQ135_DIVIDER_MILLI
        int "MQ135 AO / ADC voltage multiplier (1000 = x1)"
        range 1000 10000
        default 1000
        help
            Match actual wiring: 1000 for no divider, 2000 for equal resistors.
            This setting does not protect GPIOs. A 5V AO needs a physical divider.
            For AO--Rtop--ADC--Rbottom--GND, use 1000*(Rtop+Rbottom)/Rbottom.

    config AP_MQ135_RL_OHM
        int "MQ135 effective load resistance RL (ohm)"
        range 1 10000000
        default 10000
        help
            Reference code default only; set to the actual effective load.
            Include parallel loading from an external divider when applicable.

    config AP_MQ135_R0_OHM
        int "MQ135 reference resistance R0 (ohm)"
        range 1 10000000
        default 10000
        help
            Reference code default, not a sensor-specific calibration.
            ppm is a CO2-equivalent estimate using 116.6020682*(Rs/R0)^-2.769034857.

    config AP_WARMUP_SEC
        int "Sensor warm-up after boot (seconds)"
        range 1 172800
        default 180
        help
            Operational settling delay, not initial sensor conditioning.
            Winsen specifies over 48 hours of initial preheating.

    config AP_GOOD_RAW
        int "Good air threshold: fan off at or below this ADC count"
        range 1 4093
        default 1500
        help
            Demo threshold, not a health or ppm standard. Calibrate on hardware.

    config AP_BAD_RAW
        int "Bad air threshold: fan on at or above this ADC count"
        range 2 4093
        default 2200
        help
            Must exceed the good threshold and remain below very_bad.
            Intermediate normal values hold fan state.

    config AP_VERY_BAD_RAW
        int "Very bad air threshold (ADC count)"
        range 3 4094
        default 3000
        help
            Must exceed the bad threshold. Reports very_bad and enables
            the fan in auto mode. Demo threshold, not calibrated ppm.

endmenu
