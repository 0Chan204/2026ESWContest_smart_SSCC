# Public template. Keep credentials empty; local Kconfig.projbuild is ignored.
menu "HomeVIS induction configuration"

    config INDUCTION_NETWORK_ENABLE
        bool "Enable Wi-Fi and MQTT"
        default y

    config INDUCTION_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config INDUCTION_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config INDUCTION_MQTT_URI
        string "MQTT broker URI (mqtt://host:1883)"
        default ""

    config INDUCTION_MQTT_USERNAME
        string "MQTT username"
        default ""

    config INDUCTION_MQTT_PASSWORD
        string "MQTT password"
        default ""

    config INDUCTION_DEVICE_ID
        string "Unique MQTT client / device ID"
        default "induction-01"

    config INDUCTION_BURNER_ID
        string "Burner ID"
        default "burner-1"

    config INDUCTION_TOPIC_PREFIX
        string "MQTT topic prefix"
        default "home/kitchen/induction/induction-01"

    config INDUCTION_NTP_SERVER
        string "NTP server"
        default "pool.ntp.org"

    config INDUCTION_LED_MAX_BRIGHTNESS
        int "Maximum LED red channel brightness (12 LEDs)"
        range 9 255
        default 96

    config INDUCTION_DEFAULT_LEVEL
        int "Default level on power-on"
        range 1 9
        default 5

    config INDUCTION_OLED_ENABLE
        bool "Enable SSD1306 128x64 OLED"
        default y

    config INDUCTION_OVERHEAT_ENTER
        int "Overheat enter temperature (C)"
        range 40 350
        default 150

    config INDUCTION_OVERHEAT_EXIT
        int "Overheat exit temperature (C)"
        range 26 149
        default 60

    config INDUCTION_LED_GPIO
        int "External 12-pixel WS2812 data GPIO"
        range 0 23
        default 18

    config INDUCTION_TOUCH_GPIO
        int "External touch module GPIO (active high)"
        range 0 23
        default 19

    config INDUCTION_ENCODER_A_GPIO
        int "Encoder A GPIO"
        range 0 23
        default 20

    config INDUCTION_ENCODER_B_GPIO
        int "Encoder B GPIO"
        range 0 23
        default 21

    config INDUCTION_ENCODER_SW_GPIO
        int "Encoder switch GPIO (active low)"
        range 0 23
        default 22

    config INDUCTION_BUZZER_GPIO
        int "Passive buzzer GPIO"
        range 0 23
        default 23

    config INDUCTION_SDA_GPIO
        int "Shared OLED/GY906 SDA GPIO"
        range 0 23
        default 6

    config INDUCTION_SCL_GPIO
        int "Shared OLED/GY906 SCL GPIO"
        range 0 23
        default 7

endmenu
