menu "HomeVIS Local AP"
    config HOMEVIS_AP_SSID
        string "AP SSID"
        default "HomeVIS-Local"

    config HOMEVIS_AP_PASSWORD
        string "AP WPA2 password (8-63 bytes)"
        default ""

    config HOMEVIS_AP_CHANNEL
        int "AP channel (2.4 GHz)"
        range 1 11
        default 6

    config HOMEVIS_AP_MAX_CONNECTIONS
        int "Maximum simultaneous Wi-Fi clients"
        range 1 10
        default 4
        help
            Maximum number of receiver boards connected to this AP.
            Receivers initiate gateway pings and collect CSI themselves.

    config HOMEVIS_RGB_GPIO
        int "WS2812 RGB LED GPIO"
        range 0 30
        default 8
endmenu
