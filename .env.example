# python -m src.integration loads .env; existing OS environment takes precedence.
# Run from the repository root. Replace localhost with the board IP when remote.
HOMEVIS_MODE=live
HOMEVIS_BACKEND_URL=http://localhost:8000
HOMEVIS_BACKEND_TOKEN=
HOMEVIS_MQTT_HOST=localhost
HOMEVIS_MQTT_PORT=1883
HOMEVIS_MQTT_USERNAME=
HOMEVIS_MQTT_PASSWORD=
HOMEVIS_LOCATION_TOPIC=wifi/occupancy/state
# Optional measured behavior producer; leave blank until its topic is agreed.
HOMEVIS_BEHAVIOR_TOPIC=
# mqtt: current HomeVIS-AI_Wifi final result. backend: stored home/edge/result via HTTP.
HOMEVIS_SENSING_SOURCE=mqtt
HOMEVIS_DATA_DIR=output/integration

# LLM_PROVIDER is optional. If omitted, the existing "none" fallback remains.
# Set qwen for local Qwen, exaone for FriendliAI, or gpt for OpenAI.
LLM_PROVIDER=none
# LLM_PROVIDER=qwen
# LLM_PROVIDER=exaone
# LLM_PROVIDER=gpt

# Required only when LLM_PROVIDER=exaone. Never commit a real key.
FRIENDLI_API_KEY=
EXAONE_MODEL=LGAI-EXAONE/EXAONE-4.0-32B
EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1
EXAONE_TIMEOUT_SECONDS=30
EXAONE_MAX_RETRIES=2
EXAONE_MAX_TOKENS=256
EXAONE_TEMPERATURE=0.3

# Required only when LLM_PROVIDER=gpt. Use a model enabled for your API account.
# OpenAI API credentials are separate from FriendliAI credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
# Includes reasoning tokens for models that use reasoning. Incomplete output is rejected.
OPENAI_MAX_OUTPUT_TOKENS=2048
