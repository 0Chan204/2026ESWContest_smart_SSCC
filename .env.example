# 이 파일을 복사해서 .env 로 저장한 뒤 값을 맞게 바꿔서 사용하세요.
# cp .env.example .env

# MQTT 브로커 접속 정보 (로컬 테스트 시 기본값 그대로 사용 가능)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 이번에 다루는 인덕션 가전의 식별자
# 나중에 가전이 여러 대가 되면 토픽에 이 값이 들어가서 서로 구분됩니다.
INDUCTION_DEVICE_ID=induction-01

# --- 낙상 사고 안전 기능 ---
# 문자 발송: 솔라피(https://console.solapi.com)에서 발급
# API Key를 만들 때 허용 IP에 서버의 외부 IP를 넣어야 합니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록한 발신번호 (숫자만)
SOLAPI_SENDER_PHONE=

# SMS 확인 링크를 만들 때 쓰는 프론트(대시보드/모바일 페이지) 기본 URL
FRONTEND_BASE_URL=http://localhost:3000

# --- 데이터베이스 (MongoDB) ---
# [Docker로 실행할 때] 비워두면 같이 뜨는 로컬 MongoDB 컨테이너(mongodb://mongo:27017)를 사용합니다.
# [uvicorn으로 직접 실행할 때] 비워두면 DB 없이 메모리로만 동작합니다 (재시작 시 데이터 소실).
# Atlas를 쓰려면 Atlas의 Connect > Drivers > Python 에서 받은 접속 주소를 넣고 <db_password> 자리에 실제 비밀번호를 넣습니다.
# Atlas의 Network Access에 이 서버의 외부 IP가 등록되어 있어야 접속됩니다.
MONGODB_URI=
MONGODB_DB=homevis
# 인덕션 상태 로그 보관 기간(일)
TELEMETRY_LOG_TTL_DAYS=7

# --- Docker 실행 시에만 사용 ---
# 받아올 백엔드 이미지 태그 (기본 develop). 특정 커밋으로 되돌릴 때 sha-xxxxxxx 로 지정
# IMAGE_TAG=develop
# MongoDB 이미지 (기본 mongo:4.4, 라즈베리파이 4용). 파이 5나 노트북에서 최신 버전을 쓰려면 mongo:7
# MONGO_IMAGE=mongo:4.4

# --- 가전 목록 (비워두면 기본: 전등 light-01(방)·light-00(화장실)·light-02(부엌), 정수기 water-01, 환풍기 fan-01·fan-02, 공기청정기 air-01) ---
# 형식은 docs/AI-INTEGRATION.md 3장 참고
# HOMEVIS_DEVICES=
# 전등 깜빡임 기본 시간(초)
# LIGHT_BLINK_SEC=10

# --- 엣지 노드 · 최종 재실 판단 결과 (v0.4, docs/EDGE-MQTT.md) ---
# 합친 메시지 발행 간격(초)과 항상 포함할 구역
# EDGE_COMBINED_INTERVAL_SEC=1
# EDGE_ROOMS=room,kitchen,toilet
# 합칠 노드 메시지 종류 (토픽 home/{구역}/edge/{노드ID}/{종류}의 마지막 칸)
# EDGE_NODE_KIND=features
# 최종 판단 결과 보관 기간(일)
# SENSING_RESULT_TTL_DAYS=7

# --- 날씨 안내 (v0.3.2, Open-Meteo: API 키 불필요, 기본 위치 서울) ---
# 위치를 바꾸려면 위도/경도와 안내에 쓸 지역 이름을 넣습니다.
# WEATHER_LOCATION_NAME=서울
# WEATHER_LAT=37.5665
# WEATHER_LON=126.9780
# 날씨를 미리 받아두는 간격(초, 기본 30분). 인터넷이 없으면 false로 두고 마지막 저장값만 사용
# WEATHER_REFRESH_SEC=1800
# WEATHER_ENABLED=true

# (v0.12) true면 음성 명령 확인 창 없이 바로 실행 (인덕션 켜기·화력 조절은 항상 확인)
# VOICE_AUTO_CONFIRM=false

# --- 보드 마이크 음성 명령 · 스피커 안내 (v0.9, docs/VOICE.md 5장) ---
# 보드에서 서버가 마이크로 녹음하고 OpenAI로 음성 인식(STT) · 음성 안내(TTS)를 합니다. 키는 깃에 올리지 마세요.
# OPENAI_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# 마이크 장치 이름 (보드에서 pactl list short sources). 비우면 기본 입력 장치
# VOICE_MIC_DEVICE=alsa_input.usb-0c76_USB_Audio_Device-00.mono-fallback
# 말소리로 볼 음량(RMS). 조용한데도 듣기가 안 끝나면 올리고, 말해도 no_speech면 내립니다
# VOICE_SPEECH_RMS=500
# 버튼 뒤 말소리를 기다리는 시간 · 말이 끝났다고 볼 무음 시간 · 최대 녹음 시간(초)
# VOICE_LISTEN_START_SEC=5
# VOICE_LISTEN_SILENCE_SEC=1.0
# VOICE_LISTEN_MAX_SEC=8
# 마이크가 없는 PC에서는 false (POST /voice/listen -> 503)
# VOICE_LISTEN_ENABLED=true
# 스피커 안내를 아예 끄려면 false (화면 설정의 speak와 별개)
# VOICE_TTS_ENABLED=true
