# 이 파일을 복사해서 .env 로 저장한 뒤 값을 맞게 바꿔서 사용하세요.
# cp .env.example .env

# MQTT 브로커 접속 정보 (로컬 테스트 시 기본값 그대로 사용 가능)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 이번에 다루는 인덕션 가전의 식별자
# 나중에 가전이 여러 대가 되면 토픽에 이 값이 들어가서 서로 구분됩니다.
INDUCTION_DEVICE_ID=induction-01

# --- 낙상 사고 안전 기능 ---
# 보호자 SMS 발송: 네이버 클라우드 플랫폼(NCP) SENS 콘솔에서 발급
NAVER_SENS_SERVICE_ID=
NAVER_SENS_ACCESS_KEY=
NAVER_SENS_SECRET_KEY=
NAVER_SENS_SENDER_PHONE=

# SMS 확인 링크를 만들 때 쓰는 프론트(대시보드/모바일 페이지) 기본 URL
FRONTEND_BASE_URL=http://localhost:3000
