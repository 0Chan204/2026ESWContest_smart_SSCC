# Informational example; no automatic .env loading or hard-coded authentication scheme.
# Live mode requires --mode live explicitly; default is mock.
HOMEVIS_BACKEND_URL=
# Other settings and injected authentication headers: IntegrationConfig in
# src/integration/config.py. Never commit actual credentials.

# LLM_PROVIDER is optional. If omitted, the existing "none" fallback remains.
# Set qwen for the existing local Qwen adapter, or exaone for FriendliAI.
LLM_PROVIDER=qwen

# Required only when LLM_PROVIDER=exaone. Never commit a real key.
FRIENDLI_API_KEY=
EXAONE_MODEL=LGAI-EXAONE/EXAONE-4.0-32B
EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1
EXAONE_TIMEOUT_SECONDS=30
EXAONE_MAX_RETRIES=2
EXAONE_MAX_TOKENS=256
EXAONE_TEMPERATURE=0.3
