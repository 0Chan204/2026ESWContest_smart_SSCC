# 이 파일을 복사해서 .env 로 저장한 뒤 값을 맞게 바꿔서 사용하세요.
# cp .env.example .env

# MQTT 브로커 접속 정보 (로컬 테스트 시 기본값 그대로 사용 가능)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 이번에 다루는 인덕션 가전의 식별자
# 나중에 가전이 여러 대가 되면 토픽에 이 값이 들어가서 서로 구분됩니다.
INDUCTION_DEVICE_ID=induction-01

# --- 낙상 사고 안전 기능 ---
# 문자 발송: 솔라피(https://console.solapi.com)에서 발급
# API Key를 만들 때 허용 IP에 서버의 외부 IP를 넣어야 합니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록한 발신번호 (숫자만)
SOLAPI_SENDER_PHONE=

# SMS 확인 링크를 만들 때 쓰는 프론트(대시보드/모바일 페이지) 기본 URL
FRONTEND_BASE_URL=http://localhost:3000

# --- 데이터베이스 (MongoDB Atlas) ---
# Atlas의 Connect > Drivers > Python 에서 받은 접속 주소. <db_password> 자리에 실제 비밀번호를 넣습니다.
# 비워두면 DB 없이 메모리로만 동작합니다 (재시작 시 데이터 소실).
# Atlas의 Network Access에 이 서버의 외부 IP가 등록되어 있어야 접속됩니다.
MONGODB_URI=
MONGODB_DB=homevis
# 인덕션 상태 로그 보관 기간(일)
TELEMETRY_LOG_TTL_DAYS=7
