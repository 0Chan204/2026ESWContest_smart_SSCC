# python -m src.integration loads .env; existing OS environment takes precedence.
# Run from the repository root. Replace localhost with the board IP when remote.
# Connection defaults live in config/decision_policy.toml [backend]/[mqtt].
# Uncomment an override below only when needed; OS env > .env > TOML.
HOMEVIS_MODE=live
# HOMEVIS_BACKEND_URL=http://192.168.0.2:8000
HOMEVIS_BACKEND_TOKEN=
# HOMEVIS_MQTT_HOST=192.168.0.2
# HOMEVIS_MQTT_PORT=1883
# HOMEVIS_MQTT_CLIENT_ID=homevis-ai
# HOMEVIS_MQTT_TLS=false
# HOMEVIS_MQTT_CA_FILE=
# TLS: set true and the broker's TLS port; optional CA file, blank uses system CAs.
HOMEVIS_MQTT_USERNAME=
HOMEVIS_MQTT_PASSWORD=
# These are AI input topics, not device IDs (room=light-01, toilet=light-00, kitchen=light-02).
# HOMEVIS_LOCATION_TOPIC=wifi/occupancy/state
# Optional measured behavior producer; leave blank until its topic is agreed.
# HOMEVIS_BEHAVIOR_TOPIC=
# HOMEVIS_FALL_STATUS_TOPIC=
# Default: poll stored home/edge/result via HTTP. mqtt remains a legacy explicit option.
HOMEVIS_SENSING_SOURCE=backend
HOMEVIS_DATA_DIR=output/integration

# Optional backend v0.7 speech interaction (backend owns wake word, STT, approval and TTS).
HOMEVIS_VOICE_ENABLED=false
HOMEVIS_VOICE_TOPIC=home/voice/request
# No PM thresholds here: embedded firmware owns air-quality classification.
HOMEVIS_AIR_PURIFIER_ENABLED=true
HOMEVIS_COOKING_AIR_CLEAN_ENABLED=true
HOMEVIS_AWAY_ALL_OFF_ENABLED=true
# Keep false until the sensing producer confirms whole-home coverage/absence semantics.
HOMEVIS_WHOLE_HOME_PRESENCE_VERIFIED=false
# Fixed persistent MQTT client_id is configured in config/decision_policy.toml.
# Keep only one AI consumer; stop the backend voice-ai-simulator before live use.

# LLM_PROVIDER is used when config/decision_policy.toml [llm].provider is empty.
# An explicit provider/model in that file takes precedence; keep API keys here.
# If both provider settings are omitted, the existing "none" fallback remains.
# Set qwen for local Qwen, exaone for FriendliAI, or gpt for OpenAI.
LLM_PROVIDER=none
# LLM_PROVIDER=qwen
# LLM_PROVIDER=exaone
# LLM_PROVIDER=gpt
# LLM_PROVIDER=gemini
# Docker: leave [llm].provider/model blank in decision_policy.toml to use these values.

# Required only when LLM_PROVIDER=exaone. Never commit a real key.
FRIENDLI_API_KEY=
EXAONE_MODEL=LGAI-EXAONE/EXAONE-4.0-32B
EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1
EXAONE_TIMEOUT_SECONDS=30
EXAONE_MAX_RETRIES=2
EXAONE_MAX_TOKENS=256
EXAONE_TEMPERATURE=0.3

# Required only when LLM_PROVIDER=gpt. Use a model enabled for your API account.
# OpenAI API credentials are separate from FriendliAI credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
# Includes reasoning tokens for models that use reasoning. Incomplete output is rejected.
OPENAI_MAX_OUTPUT_TOKENS=2048

# Required only when LLM_PROVIDER=gemini. Uses Vertex AI and Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
# For compose.vertex.yaml: host path to an ADC file readable by container UID 10001.
# HOMEVIS_GOOGLE_ADC_FILE=/secure/homevis/google_adc.json
# For a native run only (Compose sets the container path automatically):
# GOOGLE_APPLICATION_CREDENTIALS=/secure/homevis/google_adc.json
